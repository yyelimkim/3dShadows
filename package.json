{
  "name": "3d-shadows",
  "version": "0.1.0",
  "private": true,
  "description": "Procedural Three.js models rebuilt from reference images with img2threejs, staged under controllable shadow lighting.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "skill:install": "npx --yes img2threejs@latest install --host claude",
    "skill:doctor": "npx --yes img2threejs@latest doctor"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
